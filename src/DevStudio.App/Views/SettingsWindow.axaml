<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DevStudio.UI.ViewModels"
        x:Class="DevStudio.App.Views.SettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Loc[Settings.Title]}"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="{Binding Loc[Settings.General]}" FontWeight="Bold" FontSize="16" />
    <Separator />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
      <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.Language]}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}"
                SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                MinWidth="200" HorizontalAlignment="Left">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LanguageOption">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <TextBlock Text="{Binding Loc[Settings.RestartRequired]}" TextWrapping="Wrap" Opacity="0.7" FontStyle="Italic" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="{Binding Loc[Settings.Close]}" Click="OnCloseClicked" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
