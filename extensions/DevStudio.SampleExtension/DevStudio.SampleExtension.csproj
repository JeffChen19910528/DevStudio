<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Private=false / ExcludeAssets=runtime: DevStudio.Core.dll must NOT be copied into this
         extension's own output directory. The extension loader's AssemblyLoadContext always
         falls back to the host's already-loaded copy of DevStudio.Core (see
         AssemblyLoadContextExtensionLoader) — a private, duplicate copy sitting next to this
         assembly would risk the classic .NET plugin pitfall of two different Type identities for
         the same IDevStudioExtension interface. -->
    <ProjectReference Include="..\..\src\DevStudio.Core\DevStudio.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
